# The legacy standalone store is intentionally retired.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name sousmarket.com www.sousmarket.com;
    server_tokens off;

    ssl_certificate /etc/letsencrypt/live/sousmarket.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sousmarket.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Restore the normal SOUS landing page with the hero banner and partner
    # programme. The page is kept outside the bot application so its design
    # is not replaced by the retired storefront.
    location = / {
        root /opt/sous-market;
        try_files /market-v2.html =404;
    }
    location = /market {
        return 410;
    }
    location ^~ /market/assets/ {
        alias /opt/sous-market/assets/;
        access_log off;
        expires 7d;
    }
    location ^~ /market/api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /market/ {
        return 410;
    }
    location = /partner {
        alias /opt/sous-market/partner.html;
        default_type text/html;
    }
    location = /supplier {
        alias /opt/sous-market/supplier.html;
        default_type text/html;
    }
    location / {
        return 301 https://sousmarketfranchize.shop$request_uri;
    }
}

server {
    listen 80;
    listen [::]:80;
    server_name sousmarket.com www.sousmarket.com;

    # Also serve the landing page directly over HTTP so an old cached
    # redirect cannot send visitors to the retired domain target.
    location = / {
        root /opt/sous-market;
        try_files /market-v2.html =404;
    }
    location = /market {
        return 410;
    }
    location ^~ /market/assets/ {
        alias /opt/sous-market/assets/;
        access_log off;
        expires 7d;
    }
    location ^~ /market/api/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /market/ {
        return 410;
    }
    location = /partner {
        alias /opt/sous-market/partner.html;
        default_type text/html;
    }
    location = /supplier {
        alias /opt/sous-market/supplier.html;
        default_type text/html;
    }
    location / {
        return 301 https://sousmarket.com$request_uri;
    }
}
