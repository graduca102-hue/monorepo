# Preparation only — do not enable until DNS for sousmarketfranchize.shop
# points to 31.77.145.160 and a matching certificate is installed.
# The current live nginx file is intentionally not changed by this snippet.

server {
    listen 80;
    listen [::]:80;
    server_name sousmarketfranchize.shop www.sousmarketfranchize.shop;

    location = / {
        return 302 /partner/souspartnersbot/;
    }

    location /partner/ {
        proxy_pass http://127.0.0.1:8081;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
    }
}
