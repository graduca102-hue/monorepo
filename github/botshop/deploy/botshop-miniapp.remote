    }

    listen 443 ssl;
    listen [::]:443 ssl;
    ssl_certificate /etc/letsencrypt/live/sousmarketfranchize.shop/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/sousmarketfranchize.shop/privkey.pem;
