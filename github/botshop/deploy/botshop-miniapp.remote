server {
    listen 80;
    listen [::]:80;
    server_name 31-77-145-160.sslip.io;
    return 410;
}
server {
    if ($host = www.sousmarketfranchize.shop) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = sousmarketfranchize.shop) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name sousmarketfranchize.shop www.sousmarketfranchize.shop;
    return 404; # managed by Certbot




}
