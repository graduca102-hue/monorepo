# Include inside each HTTPS BotShop server block.
location ~ ^/(?:api/v1|partner|miniapp|proxy|email|sms|crm)/.*?/api/ {
    limit_req zone=botshop_api burst=20 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8081;
}

location ~ ^/(?:api/v1|partner|miniapp|proxy|email|sms|crm)/.*?/(?:topup|order|checkout|promocode|payout|settings|config|broadcast) {
    limit_req zone=botshop_sensitive burst=5 nodelay;
    limit_req_status 429;
    proxy_pass http://127.0.0.1:8081;
}
