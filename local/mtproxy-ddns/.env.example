# Токен MT3S Public (Merchant API token из @confmtbot) — обязателен, только здесь
MT3S_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Зона и имя(имена) записи под MTProxy — одно или список через запятую
MTPROXY_ZONE=aikort.lol
MTPROXY_RECORD_NAME=mt,gacha,mtproto,vpn,gay,nogay,femboy,bitch,publick-mtproto,free-mtproto,proxy
MTPROXY_ZONE_FILE=/etc/bind/db.aikort.lol
MTPROXY_RECORD_TTL=60

# DNS-бэкенд, куда писать A-записи:
#   bind       — править локальный zone-файл BIND (MTPROXY_ZONE_FILE) + rndc reload
#   cloudflare — обновлять записи через Cloudflare API (CF_API_TOKEN / CF_ZONE_ID)
#   both       — писать в оба (на время переезда NS с BIND на Cloudflare)
MTPROXY_DNS_BACKEND=bind
# CF_API_TOKEN=cfat_xxx          # токен с правами Zone.DNS Edit на зону (только здесь)
# CF_ZONE_ID=xxxxxxxxxxxxxxxxx   # если пусто — ищется по имени MTPROXY_ZONE
# Cloudflare отклоняет TTL < 60 — бэкенд поднимает MTPROXY_RECORD_TTL до 60 при записи в CF.

# Опрос листенера: обычный / в режиме «текущий IP заблокирован»
MTPROXY_POLL_SECONDS=10
MTPROXY_POLL_SECONDS_BLOCKED=3
MTPROXY_HTTP_TIMEOUT=5

# Health-check кандидата перед публикацией в DNS
#   tcp     — пускать только IP, куда проходит TCP :443 (ловит RKN null-route/RST)
#   faketls — плюс реальный FakeTLS-хендшейк с секретом ниже (жёстче, требует secret)
#   off     — как раньше, просто зеркалить листенер
MTPROXY_HEALTHCHECK=faketls
MTPROXY_PROXY_PORT=443
MTPROXY_SECRET_HEX=3c0c8c099abd558ceaab5f5187cbc83e
MTPROXY_FAKETLS_SNI=xapi.ozon.ru
MTPROXY_TCP_TIMEOUT=4
# сколько раз перезапросить листенер, если и запись, и его IP выглядят заблокированными
MTPROXY_PROBE_RETRIES=6
MTPROXY_PROBE_RETRY_DELAY=2

# «Доступен ли IP из России?» — проверка через check-host.net (его RU-ноды).
# Локальный health-check бьётся с srv2 (заграница) и блок РКН только для РФ не видит.
# Если RU-ноды не достучались до IP:443 — считаем заблокированным и крутим листенер
# дальше, пока MT3S не отдаст IP, доступный из РФ.
MTPROXY_RUCHECK=on
MTPROXY_RUCHECK_NODES=ru2.node.check-host.net,ru3.node.check-host.net
MTPROXY_RUCHECK_INTERVAL=240
# require_all=true: все ответившие RU-ноды должны достучаться (строго — ловит и
# частичный блок типа «Москва режет, Питер нет»). false + MIN_OK=1 — мягче.
MTPROXY_RUCHECK_REQUIRE_ALL=true
MTPROXY_RUCHECK_MIN_OK=1

# Алерт в Telegram, если живого IP нет дольше N секунд (необязательно)
MTPROXY_ALERT_AFTER_SECONDS=300
# MTPROXY_TG_BOT_TOKEN=
# MTPROXY_TG_CHAT_ID=

# Необязательно
# MT3S_LISTENER_URL=https://api.confmtbot.com/public-listener
# MTPROXY_LOG_LEVEL=INFO
