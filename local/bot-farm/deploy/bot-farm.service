[Unit]
Description=bot-farm main control bot + all managed child bots
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/bot-farm
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/opt/bot-farm/.env
ExecStart=/opt/bot-farm/.venv/bin/python -m app.main
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
