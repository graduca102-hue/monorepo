# --- Telegram ---
BOT_TOKEN=123456:ABC...
ADMIN_IDS=111111111,222222222

# --- Subscription web (public origin that serves GET /sub/<token>) ---
# In production: a domain behind Cloudflare pointing at this host.
SUB_BASE_URL=https://sub.example.com
WEB_HOST=0.0.0.0
WEB_PORT=8080
BRAND=MyVPN
SUPPORT_URL=https://t.me/your_support

# --- Trial / limits ---
TRIAL_DAYS=3
TRIAL_TRAFFIC_GB=10
DEVICE_LIMIT=3

# --- Payments ---
STARS_PER_UNIT=1
# optional @CryptoBot app token for crypto top-ups (not required)
CRYPTO_PAY_TOKEN=

# --- Provisioning defaults (each server can override) ---
XRAY_PORT=443
MTPROTO_PORT=8443
REALITY_DEST=www.microsoft.com:443
REALITY_SNI=www.microsoft.com
SSH_TIMEOUT=600
