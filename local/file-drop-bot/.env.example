# Токен нового бота от @BotFather
BOT_TOKEN=
# Telegram id владельца (только он может загружать файлы и видеть статистику)
OWNER_ID=
# Сколько строк выдавать одному пользователю по ссылке
LINES_PER_USER=10
# Присылать владельцу уведомление о каждой выдаче (1/0)
NOTIFY_OWNER=1
# Убирать дубликаты строк при загрузке файла (1/0)
DEDUPE_LINES=1
