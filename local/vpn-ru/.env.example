# --- shared ---
DATABASE_URL=postgres://vpnru:vpnru@localhost:5432/vpnru
RUST_LOG=info,sqlx=warn

# --- api ---
API_BIND=0.0.0.0:8080
API_TOKEN=change-me-internal-service-token

# --- orchestrator ---
API_BASE_URL=http://localhost:8080
PANEL_KIND=remnawave              # remnawave | marzban
PANEL_BASE_URL=https://panel.example.net
PANEL_TOKEN=
# comma-separated cloud provider tokens used by deploy/ (never commit real values)
HETZNER_TOKEN=
VULTR_API_KEY=

# --- node-agent (per VPS) ---
NODE_ID=
NODE_AGENT_BIND=127.0.0.1:9090
ORCHESTRATOR_URL=https://orch.internal.example.net
NODE_AGENT_TOKEN=

# --- probe (inside RF) ---
PROBE_ID=ru-msk-1
PROBE_REPORT_URL=https://orch.internal.example.net/probe/report
PROBE_INTERVAL_SECS=60

# --- billing-bot ---
BOT_TOKEN=
BOT_OWNER_ID=
# public base that serves GET /sub/{token} (usually the api behind a CDN)
SUB_BASE_URL=https://sub.example.net
USDT_TRON_ADDRESS=
CRYPTO_WEBHOOK_SECRET=
