# Telegram bot token (BotFather)
BOT_TOKEN=

# Chat where escalations are posted (operator user id or group id).
# For a private DM to yourself — your own numeric user id.
OPERATOR_CHAT_ID=

# DeepSeek API key (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# SUPPORT_AI_MODEL=deepseek-chat            # or deepseek-reasoner (no tool calling)
# SUPPORT_AI_MAX_TOKENS=800
# SUPPORT_AI_TEMPERATURE=0.2
# SUPPORT_AI_HISTORY_TURNS=12
# LOG_LEVEL=INFO
# CLI_USER_ID=1
