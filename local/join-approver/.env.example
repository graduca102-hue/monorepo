# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF

# ID владельца для уведомлений об одобренных заявках (необязательно, 0 = выкл)
OWNER_ID=0

# Мгновенно одобрять все заявки (по умолчанию 1). 0 = только логировать, не одобрять
AUTO_APPROVE=1

# Приветственное сообщение одобрённому пользователю в личку (пусто = не слать)
WELCOME_TEXT=

# Список ID чатов через запятую, где работать. Пусто = работать во всех, где бот админ
ALLOWED_CHAT_IDS=

# Задержка перед одобрением в секундах (0 = моментально)
APPROVE_DELAY=0
